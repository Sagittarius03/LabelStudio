[Version]
Signature="$Windows NT$"
Class=Printer
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Provider="Seagull"
DriverVer=05/05/2026,12.3.0.0
CatalogFile=POSTEK.cat
DriverIsolation=2

[PrinterPackageInstallation.x86]
PackageAware=TRUE

[PrinterPackageInstallation.amd64]
PackageAware=TRUE

[SourceDisksNames]
1="Seagull Drivers Disk",,,\Common
2="Seagull Drivers Disk",,,\Common

[SourceDisksNames.amd64]
2="Seagull Drivers Disk",,,\x64

[SourceDisksNames.x86]
2="Seagull Drivers Disk",,,\Win32

[SourceDisksFiles]
Defaults[SS]_12.3.0.0.sds=1
eplSS_12.3.0.0.ini=1
eplSSenu_12.3.0.0.chm=1
Seagull_TCPIP_PortMonitor.dll=2
Seagull_TCPIP_PortMonitorUI.dll=2
Seagull_V3_ConfigDispatcher.dll=2
Seagull_V3_NetMonDispatcher.dll=2
Seagull_V3_PrintDispatcher.dll=2
ss#base_12.3.0.0.cab=2
ss#base_12.3.0.0.ddz=1
ss#epl_12.3.0.0.cab=2
ss#epl_12.3.0.0.ddz=1
sstcpipmon.ddz=1

[DestinationDirs]
FILES_PORT_MONITOR=11
DefaultDestDir=66000

[Manufacturer]
"POSTEK"=MODEL_POSTEK,NTamd64

[PortMonitors]
"Seagull Scientific Port"=SeagullTCPIPPortMonitor

[SeagullTCPIPPortMonitor]
CopyFiles=FILES_PORT_MONITOR
PortMonitorDll=Seagull_TCPIP_PortMonitor.dll

[FILES_PORT_MONITOR]
Seagull_TCPIP_PortMonitor.dll
Seagull_TCPIP_PortMonitorUI.dll
sstcpipmon.ddz

